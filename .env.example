API_PORT=3000
# Vermieter-Login (ein Konto; Mehrbenutzer kommt später)
LANDLORD_EMAIL=you@example.com
LANDLORD_PASSWORD=change-me
# Geheimnis zum Signieren von Session-Cookies und Mieter-Links (beliebiger langer String)
SESSION_SECRET=change-me-to-a-long-random-string
# OpenRouter für die Rechnungsextraktion
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Brevo für den Versand der Abrechnungen
BREVO_API_KEY=
MAIL_FROM_EMAIL=noreply@example.com
MAIL_FROM_NAME=Nebenkosten
# Öffentliche URL der App (für Links in Mails)
APP_URL=http://localhost:5173   # production: https://invoice.properties
# 1 = login forms are prefilled with demo credentials (also on in dev). Leave unset in production.
DEMO_MODE=
