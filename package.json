{
  "name": "property-costs-management-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=23.4"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "node --import tsx server/index.ts",
    "seed": "tsx server/seed.ts",
    "samples": "tsx scripts/make-samples.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.1",
    "express": "^5.1.0",
    "multer": "^2.0.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.17.1",
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.8.3"
  }
}
